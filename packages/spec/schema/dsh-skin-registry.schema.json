{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-skins:schema:registry:1",
  "title": "DshSkins source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skins"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "skins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "manifest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
          },
          "manifest": {
            "type": "string",
            "pattern": "^\\.\\./skins/[A-Za-z0-9._/-]+/skin\\.json$"
          }
        }
      }
    }
  }
}
