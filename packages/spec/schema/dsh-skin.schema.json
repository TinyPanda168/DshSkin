{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-skins:schema:skin:1",
  "title": "DshSkins manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "summary",
    "author",
    "license",
    "contentRating",
    "compatibility",
    "palettes",
    "assets",
    "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "author": { "$ref": "#/$defs/author" },
    "license": { "$ref": "#/$defs/license" },
    "contentRating": { "enum": ["general", "teen"] },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "palettes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/palette" },
        "dark": { "$ref": "#/$defs/palette" }
      }
    },
    "assets": { "$ref": "#/$defs/assets" },
    "previews": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/preview" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "commercialUse"],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9.+() -]+$"
        },
        "commercialUse": { "type": "boolean" },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "capability": {
      "enum": [
        "tokens.semantic.v1",
        "assets.surface.v1",
        "assets.identity.v1",
        "assets.character.states.v1"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCapabilities", "optionalCapabilities"],
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "tokens.semantic.v1" },
          "items": { "$ref": "#/$defs/capability" }
        },
        "optionalCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color.background.base",
        "color.background.surface",
        "color.background.sidebar",
        "color.text.primary",
        "color.text.secondary",
        "color.border",
        "color.accent",
        "color.accent.contrast",
        "color.state.success",
        "color.state.warning",
        "color.state.error",
        "radius.control",
        "radius.panel"
      ],
      "properties": {
        "color.background.base": { "$ref": "#/$defs/hexColor" },
        "color.background.surface": { "$ref": "#/$defs/hexColor" },
        "color.background.sidebar": { "$ref": "#/$defs/hexColor" },
        "color.text.primary": { "$ref": "#/$defs/hexColor" },
        "color.text.secondary": { "$ref": "#/$defs/hexColor" },
        "color.border": { "$ref": "#/$defs/hexColor" },
        "color.accent": { "$ref": "#/$defs/hexColor" },
        "color.accent.contrast": { "$ref": "#/$defs/hexColor" },
        "color.state.success": { "$ref": "#/$defs/hexColor" },
        "color.state.warning": { "$ref": "#/$defs/hexColor" },
        "color.state.error": { "$ref": "#/$defs/hexColor" },
        "radius.control": { "type": "integer", "minimum": 0, "maximum": 32 },
        "radius.panel": { "type": "integer", "minimum": 0, "maximum": 48 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "fit"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240,
          "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "mimeType": { "enum": ["image/png", "image/webp", "image/avif"] },
        "fit": { "enum": ["cover", "contain"] },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app.background": { "$ref": "#/$defs/asset" },
        "sidebar.background": { "$ref": "#/$defs/asset" },
        "home.hero": { "$ref": "#/$defs/asset" },
        "composer.decoration": { "$ref": "#/$defs/asset" },
        "brand.logo": { "$ref": "#/$defs/asset" },
        "agent.avatar": { "$ref": "#/$defs/asset" },
        "character.idle": { "$ref": "#/$defs/asset" },
        "character.thinking": { "$ref": "#/$defs/asset" },
        "character.tool": { "$ref": "#/$defs/asset" },
        "character.success": { "$ref": "#/$defs/asset" },
        "character.error": { "$ref": "#/$defs/asset" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mimeType", "palette"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 13,
          "maxLength": 240,
          "pattern": "^previews/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "mimeType": { "enum": ["image/png", "image/webp", "image/avif"] },
        "palette": { "enum": ["light", "dark"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aiGenerated", "rightsStatement"],
      "properties": {
        "aiGenerated": { "type": "boolean" },
        "generator": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "rightsStatement": { "type": "string", "minLength": 10, "maxLength": 500 }
      }
    }
  }
}
