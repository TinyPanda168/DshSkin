{
  "name": "@specsrelay/dsh-deepseek",
  "version": "0.5.0",
  "description": "Chrome-parity SpecsRelay requirement workspace and DeepSeek handoff inside DeepSeek Harness WebUI.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyPanda168/SpecsRelay-DSH.git"
  },
  "homepage": "https://github.com/TinyPanda168/SpecsRelay-DSH#readme",
  "bugs": {
    "url": "https://github.com/TinyPanda168/SpecsRelay-DSH/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client-native.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client-native.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
