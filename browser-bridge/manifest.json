{
  "manifest_version": 3,
  "name": "SpecsRelay DSH Bridge",
  "version": "0.3.0",
  "description": "Private DeepSeek iframe capture bridge for SpecsRelay-DSH.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.deepseek.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "dsh-page-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
